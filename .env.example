# Copy to .env for local development. In production, set these as real
# environment variables in the host/secret manager - never commit values.

# PostgreSQL (PostGIS) connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/homecare

# JWT signing - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis (booking locks + unpaid-booking expiry timers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Razorpay - use rzp_test_* keys locally, rzp_live_* only in production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me
